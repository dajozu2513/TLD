PORT=3000

# Credenciales del usuario/esquema de Oracle donde corriste 01_schema.sql
# y 02_seed.sql (NO el usuario SYSTEM, a menos que hayas creado las
# tablas directamente en ese esquema).
ORACLE_USER=tld_user
ORACLE_PASSWORD=tld_pass

# Connect string en formato host:puerto/servicio (EZCONNECT).
# - Oracle XE por defecto suele usar el servicio "XEPDB1" (pluggable DB).
# - Si tu instalación usa SID en vez de servicio, el formato es
#   host:puerto:SID (dos puntos, no diagonal), ej: localhost:1521:XE
ORACLE_CONNECT_STRING=localhost:1521/XEPDB1

# Usuario "de sistema" que queda como auditor por defecto mientras no
# hay login real (fase 1). Se crea automáticamente al iniciar el server.
DEFAULT_AUDITOR_LOGIN=auditor.demo
