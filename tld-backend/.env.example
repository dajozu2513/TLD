PORT=3000

PGHOST=localhost
PGPORT=5432
PGDATABASE=tld_db
PGUSER=tld_user
PGPASSWORD=tld_pass

# Usuario "de sistema" que queda como auditor por defecto mientras no
# hay login real (fase 1). Se crea automáticamente al iniciar el server.
DEFAULT_AUDITOR_LOGIN=auditor.demo

#*****************************************************************************
# Producción (Neon) — dejar vacío en local; Docker sigue usando las
# variables PG* de arriba.
DATABASE_URL=

# Clave compartida del equipo para /api/admin/*. Elegí una clave larga
# y única — no reutilices ninguna otra contraseña.
ADMIN_KEY=